# EditorConfig is awesome: https://EditorConfig.org\n\n# top-most EditorConfig file\nroot = true\n\n# Java files\n[*.java]\nindent_style = space\nindent_size = 4\n\n# Other files\n[*]\nindent_style = space\nindent_size = 2\nend_of_line = lf\ninsert_final_newline = true\ntrim_trailing_whitespace = true\n\n# Disable tabs\n[*.{js,html,css,py}]\nindent_style = space\nindent_size = 2\n